<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/colorWhite"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/llTopView"
        android:background="@color/colorHeaderView"
        >
        <include
            android:id="@+id/headeView"
            layout="@layout/common_header"
            />
    </LinearLayout>
    <RelativeLayout
        android:layout_below="@+id/llTopView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rl_sliderOne"
        >
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Linked TE"
                    android:paddingTop="12dp"
                    android:paddingBottom="6dp"
                    android:paddingStart="2dp"
                    android:textColor="@color/colorBlack"
                    android:textSize="12sp"
                    />
                <EditText
                    android:id="@+id/et_linked_dealer"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textColor="@color/colorBlack"
                    android:padding="3dp"
                    android:background="@drawable/border_grey"
                    android:text=""
                    android:tag=""
                    android:textSize="12sp"
                    android:enabled="false"
                    android:gravity="center|start"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Product Name"
                    android:paddingTop="12dp"
                    android:paddingBottom="6dp"
                    android:paddingStart="2dp"
                    android:textColor="@color/colorBlack"
                    android:textSize="12sp"
                    />
                <RelativeLayout
                    android:id="@+id/rl_product"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:background="@drawable/border_grey"

                    >
                    <TextView
                        android:id="@+id/et_product"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textColor="@color/colorBlack"
                        android:padding="3dp"
                        android:background="@null"
                        android:text=""
                        android:gravity="center|start"
                        android:textSize="12sp"
                        android:layout_toStartOf="@+id/iv_prod"
                        android:tag=""
                        android:onClick="expectedProd_Dialog"
                        android:clickable="true"
                        />
                    <ImageView
                        android:id="@+id/iv_prod"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/dd"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="10dp"
                        android:layout_centerVertical="true"
                        android:onClick="expectedProd_Dialog"
                        android:clickable="true"
                        />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quantity in bags"
                    android:paddingTop="12dp"
                    android:paddingBottom="6dp"
                    android:paddingStart="2dp"
                    android:textColor="@color/colorBlack"
                    android:textSize="12sp"
                    />
                <EditText
                    android:id="@+id/et_quantity"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textColor="@color/colorBlack"
                    android:padding="3dp"
                    android:background="@drawable/border_grey"
                    android:text=""
                    android:tag=""
                    android:textSize="12sp"
                    android:inputType="number"
                    android:maxLength="6"
                    android:imeOptions="actionNext"
                    android:gravity="center|start"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date of Requirement"
                    android:paddingTop="12dp"
                    android:paddingBottom="6dp"
                    android:paddingStart="2dp"
                    android:textColor="@color/colorBlack"
                    android:textSize="12sp"
                    />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:background="@drawable/border_grey"

                    >
                    <TextView
                        android:id="@+id/et_date_of_lifting"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textColor="@color/colorBlack"
                        android:padding="3dp"
                        android:background="@null"
                        android:text=""
                        android:textSize="12sp"
                        android:layout_toStartOf="@+id/iv_date_of_lifting"
                        android:tag=""
                        android:onClick="show_calendar"
                        android:clickable="true"
                        android:gravity="center|start"
                        />
                    <ImageView
                        android:id="@+id/iv_date_of_lifting"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="10dp"
                        android:layout_centerVertical="true"
                        android:onClick="show_calendar"
                        android:clickable="true"
                        />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/ll_remarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Remarks"
                        android:paddingTop="12dp"
                        android:paddingBottom="6dp"
                        android:paddingStart="2dp"
                        android:textColor="@color/colorBlack"
                        android:textSize="12sp"
                        />
                    <EditText
                        android:id="@+id/et_remarks"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:textColor="@color/colorBlack"
                        android:padding="3dp"
                        android:background="@drawable/border_grey"
                        android:text=""
                        android:gravity="top"
                        android:maxLines="9"
                        android:inputType="textMultiLine"
                        android:maxEms="15"
                        android:textSize="12sp"

                        />
                </LinearLayout>
                <Button
                    android:id="@+id/btn_lifting_submit"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="25dp"
                    android:background="#363f45"
                    android:text="Submit"
                    android:textColor="@color/white"

                    />
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</RelativeLayout>
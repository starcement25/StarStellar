    <!-- Pending List -->
    <ListView
        android:id="@+id/lv_Pending"
        android:layout_below="@id/llTopView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/colorWhite"
        android:dividerHeight="2dp"
        android:visibility="visible"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"/>

    <!-- Delivered List -->
    <ListView
        android:id="@+id/lv_delivered"
        android:layout_below="@id/llTopView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/colorWhite"
        android:dividerHeight="2dp"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"/>

    <!-- No Pending -->
    <LinearLayout
        android:id="@+id/ll_no_record_p"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NO PENDING ORDERS"
            android:gravity="center"
            android:textColor="@color/colorDarkGray"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/tv_no_record_p"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Redeem NOW"
            android:gravity="center"
            android:padding="@dimen/padding_Top_Bottom"
            android:textSize="12sp"
            android:textColor="@color/colorDarkGray_gb"
            android:clickable="true"
            android:onClick="no_pending_order_redeem_now"/>
    </LinearLayout>

    <!-- No Delivered -->
    <LinearLayout
        android:id="@+id/ll_no_record_d"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NO ORDERS YET"
            android:gravity="center"
            android:textColor="@color/colorDarkGray"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/tv_no_record_d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Redeem Your Gift"
            android:gravity="center"
            android:padding="@dimen/padding_Top_Bottom"
            android:textSize="12sp"
            android:textColor="@color/colorDarkGray_gb"
            android:clickable="true"
            android:onClick="no_order_redeem_gift"/>
    </LinearLayout>

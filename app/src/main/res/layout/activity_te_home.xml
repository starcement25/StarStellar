<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/llTopView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorHeaderView">

                <include
                    android:id="@+id/headeView"
                    layout="@layout/common_header_home" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llTopView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorDarkGray_gb"
                        android:minHeight="50dp"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/left_right_margin_15dp"
                        android:paddingTop="@dimen/padding_Top_Bottom"
                        android:paddingRight="@dimen/left_right_margin_3dp"
                        android:paddingBottom="@dimen/padding_Top_Bottom">

                        <TextView
                            android:id="@+id/tv_TE_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="top|left"
                            android:maxLines="2"
                            android:text="Hi, \n"
                            android:textColor="@color/colorWhite"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_TE_points"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="top|left"
                            android:maxLines="1"
                            android:paddingTop="@dimen/left_right_margin_3dp"
                            android:text="Stellar Points : "
                            android:textColor="@color/colorWhite"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/rl_middle_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/ll_redeem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="7dp">

                            <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/tools"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:elevation="7dp"
                                card_view:cardCornerRadius="7dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="150dp"
                                    android:background="@color/colorWhite"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:layout_weight="2"
                                        android:orientation="vertical"
                                        android:padding="4dp">

                                        <TextView
                                            android:id="@+id/tv_top_section_header_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:ellipsize="end"
                                            android:maxLines="2"
                                            android:padding="@dimen/left_right_margin_3dp"
                                            android:text=""
                                            android:textColor="#1f539c"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_redeem_d"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:ellipsize="end"
                                            android:maxLines="4"
                                            android:padding="@dimen/left_right_margin_3dp"
                                            android:text=""
                                            android:textColor="@color/colorDarkGray"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="105dp"
                                        android:layout_gravity="top"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <ImageView
                                            android:id="@+id/iv_redeem_p"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_gravity="center"
                                            android:layout_margin="@dimen/left_right_margin_3dp"
                                            android:adjustViewBounds="true"
                                            android:scaleType="fitXY"
                                            android:src="@drawable/sample_man_square" />
                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <GridView
                            android:id="@+id/gv_home_menu_te"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/padding_Top_Bottom"
                            android:layout_marginTop="125dp"
                            android:layout_marginRight="@dimen/padding_Top_Bottom"
                            android:background="@android:color/transparent"
                            android:listSelector="@color/transparent"
                            android:minHeight="100dp"
                            android:numColumns="4"
                            android:padding="0dp"
                            android:verticalSpacing="0dp" />

                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/padding_Top_Bottom"
                        android:visibility="invisible" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/left_right_margin_15dp"
                        android:layout_marginRight="@dimen/left_right_margin_15dp"
                        android:background="@android:color/transparent"
                        android:gravity="center">

                        <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/tools"
                            android:id="@+id/cv_"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:elevation="7dp"
                            card_view:cardCornerRadius="7dp">

                            <androidx.viewpager.widget.ViewPager
                                android:id="@+id/vp_slider"
                                android:layout_width="match_parent"
                                android:layout_height="175dp" />
                        </androidx.cardview.widget.CardView>


                        <LinearLayout
                            android:id="@+id/ll_dots"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/cv_"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:padding="@dimen/left_right_margin_3dp">

                        </LinearLayout>
                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="9dp"
                        android:visibility="invisible" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/left_right_margin_15dp"
                        android:layout_marginRight="@dimen/left_right_margin_15dp"
                        android:background="@android:color/transparent"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_top_pics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:paddingLeft="2dp"
                            android:paddingBottom="@dimen/left_right_margin_3dp"
                            android:singleLine="true"
                            android:text="Top picks"
                            android:textColor="@color/colorDarkGray_gb"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/tools"
                            android:id="@+id/cv_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/tv_top_pics"
                            android:elevation="7dp"
                            card_view:cardCornerRadius="7dp">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_top_pics"
                                android:layout_width="match_parent"
                                android:layout_height="175dp"
                                android:layout_below="@id/llTopView"
                                android:divider="@color/colorWhite"
                                android:dividerHeight="2dp"
                                android:visibility="visible"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                        </androidx.cardview.widget.CardView>

                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/left_right_margin_15dp"
                        android:visibility="invisible" />
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/option_layout"
            android:layout_width="268dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/colorWhite"
            android:orientation="vertical"
            android:paddingTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/tv_app_version"
                android:layout_alignParentTop="true"
                android:orientation="vertical">

                <include
                    layout="@layout/app_logo_layout"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <ListView
                    android:id="@+id/lvSideMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="#d3d3d3"
                    android:dividerHeight="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:padding="4dp"
                android:text="App version- 0.0"
                android:textColor="@color/colorDarkGray"
                android:textSize="8sp" />
        </RelativeLayout>
    </androidx.drawerlayout.widget.DrawerLayout>

    <LinearLayout
        android:id="@+id/reward_t_and_c_popup_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#70000000"
        android:gravity="center"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/popup_design_t_and_c"
            android:elevation="3dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/popup_header_t_and_c"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms &amp; Condition"
                    android:textColor="@color/white"
                    android:textFontWeight="600"
                    android:textSize="16dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="15dp">

                <WebView
                    android:id="@+id/reward_t_and_c_popup_webview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="300dp"
                    android:minHeight="50dp"
                    android:scrollbars="vertical" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/popup_check_box"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/baseline_check_box_outline_blank_24" />

                    <TextView
                        android:id="@+id/popup_check_box_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Accept T &amp; C"
                        android:textColor="@color/red" />
                </LinearLayout>

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp" />

                <Button
                    android:id="@+id/popup_t_c_submit_button"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/button_background_red"
                    android:text="Submit"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/llTopView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorHeaderView">

        <include
            android:id="@+id/headeView"
            layout="@layout/common_header_engineer" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_my_eng_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/llTopView"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_Search_Eng"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="6"
            android:background="@null"
            android:hint="Type engineer name"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="99"
            android:maxLines="1"
            android:padding="@dimen/left_right_margin_15dp"
            android:textColor="@color/colorBlack"
            android:visibility="visible" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:clickable="true"
            android:onClick="my_eng_reset"
            android:src="@drawable/t_cross" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/ll_my_eng_search"
        android:background="@color/red"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_MyEngineer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tv_pending_engineer"
        android:layout_below="@id/tv_line"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:divider="@color/colorWhite"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/tv_pending_engineer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/padding_Top_Bottom"
        android:background="@drawable/border_red_solid"
        android:clickable="true"
        android:gravity="center"
        android:onClick="pendingEngineer"
        android:padding="@dimen/left_right_margin_15dp"
        android:text="0 ENGINEERS TO BE APPROVED"
        android:textColor="@color/white"
        android:visibility="gone" />
</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F2F0F1"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="2"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="7dp"
            android:layout_margin="3dp"
            card_view:cardCornerRadius="7dp"
            xmlns:card_view="http://schemas.android.com/tools"
            >
            <ImageView
                android:id="@+id/iv_gift_item"
                android:layout_width="match_parent"
                android:layout_height="77dp"
                android:src="@drawable/default_"
                />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="4"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:padding="2dp"
        >
        <TextView
            android:id="@+id/tv_P_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorDarkGray_gb"
            android:textSize="12sp"
            android:text="Item"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingRight="2dp"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="1dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            >
            <TextView
                android:id="@+id/tv_P_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textColor="@color/colorDarkGray"

                android:textSize="12sp"
                android:text="0 PT"
                android:textStyle="bold"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_gravity="center"
                />
            <TextView
                android:id="@+id/tv_support"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text=""
                android:gravity="center"
                android:layout_gravity="center"
                android:textSize="12sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            >
            <TextView
                android:id="@+id/tv_P_order_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorDarkGray"

                android:textSize="12sp"
                android:text="Order Id :"
                android:textStyle="bold"

                />
            <TextView
                android:id="@+id/tv_gift_Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:gravity="center"
                android:textSize="10sp"
                android:layout_gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            >
            <TextView
                android:id="@+id/tv_order_del_date"
                android:layout_width="0dp"
                android:layout_weight="3"
                android:layout_height="wrap_content"
                android:textColor="@color/colorDarkGray"
                android:textSize="12sp"
                android:text="Delivery Date : 00/00/0000"
                android:textStyle="bold"
                android:paddingTop="2dp"
                android:paddingRight="2dp"
                android:paddingBottom="2dp"
                />
            <TextView
                android:id="@+id/tv_gift_delivered"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Delivered"
                android:gravity="center"
                android:textSize="10sp"
                android:layout_gravity="center"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@android:color/black"
                android:background="@drawable/border_deep_gray"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorDarkGray"

                android:textSize="12sp"
                android:text="Type : "
                android:textStyle="bold"

                />
            <TextView
                android:id="@+id/tv_p_TYPE"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:gravity="center"
                android:textSize="10sp"
                android:layout_gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingEnd="2dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorDarkGray"

                android:textSize="12sp"
                android:text="Comments : "
                android:textStyle="bold"

                />
            <TextView
                android:id="@+id/tv_p_Comments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:gravity="center"
                android:textSize="10sp"
                android:layout_gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorDarkGray"

                android:textSize="12sp"
                android:text="Status : "
                android:textStyle="bold"

                />
            <TextView
                android:id="@+id/tv_p_Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:gravity="center"
                android:textSize="10sp"
                android:layout_gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                />
        </LinearLayout>

    </LinearLayout>


    <TextView
        android:id="@+id/tv_json_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        />
</LinearLayout>
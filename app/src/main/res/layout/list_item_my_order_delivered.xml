<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="#F9F9F9">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        card_view:cardCornerRadius="10dp"
        card_view:cardElevation="3dp"
        android:backgroundTint="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- All info rows -->
            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFF4F4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="wrap_content"
                    android:text="Order Id :"
                    android:textColor="#E85C75"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E1E1E1"
                    android:layout_marginHorizontal="6dp" />

                <TextView
                    android:id="@+id/textViewOrderId"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content"
                    android:text="ORD10316"
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="wrap_content"
                    android:text="Product Details :"
                    android:textColor="#E85C75"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E1E1E1"
                    android:layout_marginHorizontal="6dp" />

                <TextView
                    android:id="@+id/textViewProductName"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content"
                    android:text="2025-09-24 13:37:09"
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFF4F4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="wrap_content"
                    android:text="Order Date :"
                    android:textColor="#E85C75"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E1E1E1"
                    android:layout_marginHorizontal="6dp" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content"
                    android:text="2025-09-24 13:37:09"
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="wrap_content"
                    android:text="Points :"
                    android:textColor="#E85C75"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E1E1E1"
                    android:layout_marginHorizontal="6dp" />

                <TextView
                    android:id="@+id/textViewProductCount"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content"
                    android:text="Points - 0\nTDS - 0\nTotal - 0"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:maxLines="5"
                    android:ellipsize="end" />
            </LinearLayout>



            <!-- Row 4 -->
            <!--            <LinearLayout-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:orientation="horizontal"-->
            <!--                android:padding="8dp"-->
            <!--                android:background="#FFFFFF">-->

            <!--                <TextView-->
            <!--                    android:layout_width="0dp"-->
            <!--                    android:layout_weight="4"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:text="Points :"-->
            <!--                    android:textColor="#E85C75"-->
            <!--                    android:textStyle="bold"-->
            <!--                    android:textSize="13sp" />-->

            <!--                <View-->
            <!--                    android:layout_width="1dp"-->
            <!--                    android:layout_height="match_parent"-->
            <!--                    android:background="#E1E1E1"-->
            <!--                    android:layout_marginHorizontal="6dp" />-->

            <!--                <TextView-->
            <!--                    android:id="@+id/tv_gift_Status"-->
            <!--                    android:layout_width="0dp"-->
            <!--                    android:layout_weight="6"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:text="28"-->
            <!--                    android:textColor="#000000"-->
            <!--                    android:textSize="13sp" />-->
            <!--            </LinearLayout>-->

            <!-- Row 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFF4F4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="wrap_content"
                    android:text="Delivery Status :"
                    android:textColor="#E85C75"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E1E1E1"
                    android:layout_marginHorizontal="6dp" />

                <TextView
                    android:id="@+id/textViewOrderStatus"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content"
                    android:text="Complaint/Feedback"
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Row 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="wrap_content"
                    android:text="Delivery Date :"
                    android:textColor="#E85C75"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E1E1E1"
                    android:layout_marginHorizontal="6dp" />

                <TextView
                    android:id="@+id/textViewDeliveryDate"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content"
                    android:text="27-10-2025"
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Row 7 -->
            <LinearLayout
                android:id="@+id/llTrackingId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFF4F4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="wrap_content"
                    android:text="Tracking Order Id :"
                    android:textColor="#E85C75"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E1E1E1"
                    android:layout_marginHorizontal="6dp" />

                <TextView
                    android:id="@+id/tvAmazonOrderId"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content"
                    android:text="Tracking Order Id - "
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llRemarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="wrap_content"
                    android:text="Remarks :"
                    android:textColor="#E85C75"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E1E1E1"
                    android:layout_marginHorizontal="6dp" />

                <TextView
                    android:id="@+id/tvRemarks"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="8dp" />

            <!-- Bottom Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="8dp">

                <Button
                    android:id="@+id/trackOrderButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:visibility="gone"
                    android:text="Track Order"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/acknowledgementButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:text="Acknowledge Delivery"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#ee1d23"
                    android:visibility="gone"
                    android:layout_marginHorizontal="4dp" />

                <!-- ⭐ NEW BUTTON ADDED ⭐ -->
                <Button
                    android:id="@+id/btnNotDelivered"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:text="Not Delivered"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#ee1d23"
                    android:backgroundTint="#ffd4d7"
                    android:visibility="visible"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/complaintButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:text="Feedback / Complaint"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#ee1d23"
                    android:backgroundTint="#ffd4d7"
                    android:layout_marginHorizontal="4dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_json_row"
            android:layout_width="0dp"
            android:layout_height="0dp"
            />
    </androidx.cardview.widget.CardView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F2F0F1">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/llTopView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorHeaderView">

                <include
                    android:id="@+id/headeView"
                    layout="@layout/common_header_home" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llTopView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ll_stellar_points"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorDarkGray_gb"
                        android:minHeight="45dp"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/left_right_margin_15dp"
                        android:paddingTop="@dimen/padding_Top_Bottom"
                        android:paddingRight="@dimen/left_right_margin_3dp"
                        android:paddingBottom="@dimen/padding_Top_Bottom">

                        <TextView
                            android:id="@+id/tv_E_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="top|left"
                            android:maxLines="2"
                            android:text="Hi, \n"
                            android:textColor="@color/colorWhite"
                            android:textSize="12sp" />

<!--                        <TextView-->
<!--                            android:id="@+id/tv_E_points"-->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_balance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/left_right_margin_15dp"
                        android:layout_marginVertical="8dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="10dp"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="40dp"
                            android:paddingVertical="20dp"
                            android:gravity="center"
                            android:background="@color/colorWhite">

                            <!-- Small decorative pill -->
                            <View
                                android:layout_width="36dp"
                                android:layout_height="4dp"
                                android:background="#F44336"
                                android:alpha="0.5"
                                android:layout_marginBottom="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AVAILABLE POINTS"
                                android:textColor="#F44336"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.12"
                                android:alpha="0.9" />

                            <TextView
                                android:id="@+id/tv_balance_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="0"
                                android:textColor="#F44336"
                                android:textSize="48sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stellar Points"
                                android:textColor="#AAAAAA"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>



                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/left_right_margin_15dp"
                                            android:visibility="invisible" />
                                    </LinearLayout>
                                </ScrollView>
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/option_layout"
                                android:layout_width="268dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:background="@color/colorWhite"
                                android:orientation="vertical"
                                android:paddingTop="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_above="@+id/tv_app_version"
                                    android:layout_alignParentTop="true"
                                    android:orientation="vertical">

                                    <include
                                        layout="@layout/app_logo_layout"
                                        android:layout_width="match_parent"
                                        android:layout_height="200dp" />

                                    <ListView
                                        android:id="@+id/lvSideMenu"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:divider="#d3d3d3"
                                        android:dividerHeight="1dp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_app_version"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:padding="4dp"
                                    android:text="App version- 0.0"
                                    android:textColor="@color/colorDarkGray"
                                    android:textSize="8sp" />
                            </RelativeLayout>
                        </androidx.drawerlayout.widget.DrawerLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:id="@+id/ack_warning_popup_layout"
                            android:background="#70000000"
                            android:paddingHorizontal="20dp"
                            android:gravity="center">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/popup_design_t_and_c"
                                android:orientation="vertical"
                                android:elevation="3dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="@drawable/popup_header_t_and_c"
                                    android:gravity="center">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Acknowledment Warning"
                                        android:textSize="16dp"
                                        android:textFontWeight="600"
                                        android:textColor="@color/white"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="20dp"
                                    android:paddingVertical="15dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:id="@+id/ackWarning_text"
                                        android:textSize="14dp"
                                        android:text="Your order have been delivered recently. Please acknowledge and confirm your delivery."
                                        android:textColor="#333"/>
                                    <View
                                        android:layout_width="wrap_content"
                                        android:layout_height="10dp"/>
                                    <Button
                                        android:layout_width="160dp"
                                        android:layout_height="40dp"
                                        android:id="@+id/popup_ack_warning_button"
                                        android:layout_gravity="center_horizontal"
                                        android:text="Go to Order List"
                                        android:textColor="@color/white"
                                        android:background="@drawable/button_background_red"
                                        android:textAllCaps="false"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:id="@+id/not_now_popup_layout"
                            android:background="#70000000"
                            android:paddingHorizontal="20dp"
                            android:gravity="center">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/popup_design_t_and_c"
                                android:orientation="vertical"
                                android:elevation="3dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="@drawable/popup_header_t_and_c"
                                    android:gravity="center">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Sorry for Inconvenience"
                                        android:textSize="16dp"
                                        android:textFontWeight="600"
                                        android:textColor="@color/white"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="20dp"
                                    android:paddingVertical="15dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:id="@+id/notNow_text"
                                        android:textSize="14dp"
                                        android:text="Lorem ipsum is a dummy or placeholder text commonly used in graphic design, publishing, and web development."
                                        android:textColor="#333"/>
                                    <View
                                        android:layout_width="wrap_content"
                                        android:layout_height="10dp"/>
                                    <Button
                                        android:layout_width="160dp"
                                        android:layout_height="40dp"
                                        android:id="@+id/popup_not_now_button"
                                        android:layout_gravity="center_horizontal"
                                        android:text="Back"
                                        android:textColor="@color/white"
                                        android:background="@drawable/button_background_red"
                                        android:textAllCaps="false"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

    <RelativeLayout
        android:id="@+id/birthday_popup_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#90000000"
        android:clickable="true"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="visible">


        <RelativeLayout
            android:id="@+id/birthday_card_container"
            android:layout_width="match_parent"
            android:layout_height="450dp"
            android:background="@drawable/wish_bg"
            android:layout_centerInParent="true"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/birthday_background_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wish_backgroud"
                android:clipToOutline="true"
                android:scaleType="centerCrop" />


            <ImageView
                android:id="@+id/birthday_popup_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_margin="12dp"
                android:background="@drawable/circle_white_bg"
                android:padding="6dp"
                android:src="@drawable/ic_close_red"
                android:clickable="true"
                android:elevation="2dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:paddingTop="100dp"
                android:paddingBottom="80dp"
                android:minHeight="450dp">

                <TextView
                    android:id="@+id/birthday_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Happy Birthday!"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="serif"
                    android:shadowColor="#40000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"/>

                <TextView
                    android:id="@+id/birthday_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Jayanta Sarkar"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:layout_marginTop="8dp"
                    android:shadowColor="#40000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"/>

                <TextView
                    android:id="@+id/birthday_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:lineSpacingExtra="4dp"
                    android:shadowColor="#40000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~ Star Cement Family"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@color/white"
                    android:layout_marginTop="25dp"
                    android:shadowColor="#40000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"/>

            </LinearLayout>

        </RelativeLayout>
    </RelativeLayout>
                    </RelativeLayout>
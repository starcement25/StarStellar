<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:layout_margin="@dimen/padding_Top_Bottom"
    >
    <TextView
        android:id="@+id/tv_cross"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="X"
        android:textColor="@color/colorDarkGray_gb"
        android:padding="@dimen/padding_Top_Bottom"
        android:textSize="12sp"
        android:layout_gravity="right"
        android:textStyle="bold"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/left_right_margin_15dp"
        android:text="@string/tc"
        android:layout_gravity="center"
        android:gravity="left"
        />
</LinearLayout>
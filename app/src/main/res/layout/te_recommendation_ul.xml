<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/llTopView"
        android:background="@color/colorHeaderView"
        >
        <include
            android:id="@+id/headeView"
            layout="@layout/common_header"
            />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llTopView"
        android:id="@+id/sv_recomm"
        android:layout_above="@+id/ll_recomm_bottom"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorWhite"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:background="#f2f0f1"
                >
                <ImageView
                    android:id="@+id/iv_mySite_"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_"
                    android:layout_margin="@dimen/left_right_margin_15dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:background="@color/colorDarkGray_gb"
                android:text="DETAILS OF RECOMMENDATION"
                android:textColor="@color/colorWhite"
                android:textStyle="bold"
                android:textSize="12sp"
                />
            <forcepower.com.star_stellar.Class.NonScrollListView
                android:id="@+id/lv_recom_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:layout_marginBottom="10dp"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:layout_marginTop="@dimen/padding_Top_Bottom"
                android:background="@color/colorDarkGray_gb"
                android:text="DETAILS OF PRODUCT"
                android:textColor="@color/colorWhite"
                android:textStyle="bold"
                android:textSize="12sp"
                />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingLeft="@dimen/left_right_margin_15dp"
                android:paddingRight="@dimen/padding_Top_Bottom"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    >

                    <EditText
                        android:id="@+id/et_Select_product"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:hint="Select product *"
                        android:singleLine="true"
                        android:maxLength="99"
                        android:textSize="12sp"
                        android:drawableRight="@drawable/drop"
                        android:focusable="false"
                        android:editable="false"
                        android:clickable="true"
                        />

                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <EditText
                        android:id="@+id/et_Consumption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:hint="Actual Consumption (No. of bags)"
                        android:inputType="number"
                        android:singleLine="true"
                        android:maxLength="19"
                        android:textSize="12sp"
                        />

                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorDarkGray_gb"
                    android:textSize="12sp"
                    android:text="From where the bags have been purchased"
                    android:textStyle="bold"
                    android:layout_gravity="top"
                    android:layout_marginTop="@dimen/padding_Top_Bottom"
                    android:layout_marginLeft="@dimen/padding_Top_Bottom"
                    />
                <RadioGroup
                    android:id="@+id/rg_dealer_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:checkedButton="@id/rb_0"
                    >
                    <RadioButton
                        android:id="@+id/rb_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dealer"
                        />
                    <RadioButton
                        android:id="@+id/rb_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subdealer"
                        />

                </RadioGroup>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/et_Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:hint="Name *"
                        android:singleLine="true"
                        android:maxLength="99"
                        android:textSize="12sp"
                        />

                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/et_Area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:hint="Area *"
                        android:singleLine="true"
                        android:maxLength="99"
                        android:textSize="12sp"
                        />

                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <EditText
                        android:id="@+id/et_Contact_Number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:hint="Contact Number *"
                        android:inputType="number"
                        android:singleLine="true"
                        android:maxLength="10"
                        android:textSize="12sp"
                        />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:layout_marginTop="@dimen/left_right_margin_15dp"
                android:background="@color/colorDarkGray_gb"
                android:text="ENGINEER DETAILS"
                android:textColor="@color/colorWhite"
                android:textStyle="bold"
                android:textSize="12sp"
                />
            <forcepower.com.star_stellar.Class.NonScrollListView
                android:id="@+id/lv_te_eng_ul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:layout_marginBottom="10dp"
                />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingLeft="@dimen/left_right_margin_15dp"
                android:paddingRight="@dimen/padding_Top_Bottom"
                android:paddingBottom="@dimen/padding_Top_Bottom"
                android:paddingTop="@dimen/padding_Top_Bottom"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorDarkGray_gb"
                    android:textSize="12sp"
                    android:text="Comments : "
                    android:textStyle="bold"
                    android:layout_gravity="top"
                    />
                <EditText
                    android:id="@+id/et_site_comments"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:textColor="@color/colorDarkGray_gb"
                    android:textSize="12sp"
                    android:hint="Write comments"
                    android:gravity="top"
                    android:padding="@dimen/left_right_margin_3dp"
                    android:inputType="textMultiLine"
                    android:maxLines="9"
                    android:background="@drawable/border_gray_solid"

                    />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_right_margin_15dp"
                android:visibility="invisible"
                />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:id="@+id/ll_recomm_bottom"
        android:layout_margin="5dp"
        >
        <TextView
            android:id="@+id/tv_recomm_confirm"
            android:layout_width="match_parent"
            android:layout_height="45dp"

            android:background="@drawable/border_red_solid"
            android:textColor="@color/white"
            android:gravity="center"
            android:text="CONFIRM"
            android:clickable="true"
            android:onClick="recomm_confirm"
            android:layout_margin="5dp"
            />

    </LinearLayout>
</RelativeLayout>
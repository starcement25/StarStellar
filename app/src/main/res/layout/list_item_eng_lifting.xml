<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F2F0F1"
    android:layout_marginLeft="@dimen/left_right_margin_3dp"
    android:layout_marginRight="@dimen/left_right_margin_3dp"
    android:layout_marginTop="1.25dp"
    android:layout_marginBottom="1.25dp"
    android:id="@+id/ll_my_Engineer"
    >
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_my_engg_dp"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:src="@drawable/en_profile"
        android:layout_gravity="center"
        android:padding="2dp"
        />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="8"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/padding_Top_Bottom"
        >
        <TextView
            android:id="@+id/tv_lifting_engg_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorDarkGray_gb"
            android:textSize="12sp"
            android:text="Name"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingBottom="1dp"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/tv_lifting_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorDarkGray"
            android:textSize="12sp"
            android:text="Mobille"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            />
        <TextView
            android:id="@+id/tv_lifting_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorDarkGray"

            android:textSize="12sp"
            android:text="Address"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/drop"
        android:rotation="270"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        />
    <TextView
        android:id="@+id/tv_json_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        />
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_my_Engineer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/left_right_margin_3dp"
    android:layout_marginTop="1.25dp"
    android:layout_marginRight="@dimen/left_right_margin_3dp"
    android:layout_marginBottom="1.25dp"
    android:background="#FFFFFF"
    android:orientation="horizontal">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_my_engg_dp"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_gravity="center"
        android:padding="2dp"
        android:src="@drawable/en_profile" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="8"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/left_right_margin_3dp">

        <TextView
            android:id="@+id/tv_my_engg_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:text="Name"
            android:textColor="@color/colorDarkGray_gb"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_my_engg_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:text="Mobile"
            android:textColor="@color/colorDarkGray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_my_engg_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:text="Address"
            android:textColor="@color/colorDarkGray"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Last recommended date : "
                android:textColor="@color/colorDarkGray_gb"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_my_engg_recomm_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="00-00-0000"
                android:textColor="@color/colorDarkGray"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight=".75"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/left_right_margin_3dp">

        <TextView
            android:id="@+id/tv_status_circle"
            android:layout_width="@dimen/left_right_margin_15dp"
            android:layout_height="@dimen/left_right_margin_15dp"
            android:background="@drawable/border_ring_green" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/left_right_margin_15dp"
        android:layout_height="@dimen/left_right_margin_15dp"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:rotation="270"
        android:src="@drawable/drop" />

    <TextView
        android:id="@+id/tv_json_row"
        android:layout_width="0dp"
        android:layout_height="0dp" />
</LinearLayout>
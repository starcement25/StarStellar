<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorWhite">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/llTopView"
        android:background="@color/colorHeaderView"
        >
        <include
            android:id="@+id/headeView"
            layout="@layout/common_header"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_below="@id/llTopView"
        android:id="@+id/ll_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        >
        <LinearLayout
            android:id="@+id/ll_mysite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#414141"
            >
            <TextView
                android:id="@+id/tv_pending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pending"
                android:textColor="@color/white"
                android:gravity="center"
                android:paddingTop="@dimen/left_right_margin_15dp"
                android:paddingBottom="@dimen/left_right_margin_15dp"
                android:onClick="pendingList"
                android:background="#414141"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textAllCaps="true"
                />
            <TextView
                android:id="@+id/tv_approved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Approved"
                android:textColor="#878787"
                android:gravity="center"
                android:paddingTop="@dimen/left_right_margin_15dp"
                android:paddingBottom="@dimen/left_right_margin_15dp"
                android:onClick="approvedList"
                android:background="#414141"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textAllCaps="true"
                />
            <TextView
                android:id="@+id/tv_rejected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rejected"
                android:textColor="#878787"
                android:gravity="center"
                android:paddingTop="@dimen/left_right_margin_15dp"
                android:paddingBottom="@dimen/left_right_margin_15dp"
                android:onClick="rejectedList"
                android:background="#414141"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textAllCaps="true"
                />
        </LinearLayout>

    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_Pending"
        android:layout_below="@id/ll_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        android:dividerHeight="2dp"
        android:divider="@color/colorWhite"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_Approved"
        android:layout_below="@id/ll_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dividerHeight="2dp"
        android:divider="@color/colorWhite"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"
        android:visibility="gone"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_Rejected"
        android:layout_below="@id/ll_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dividerHeight="2dp"
        android:divider="@color/colorWhite"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"
        android:visibility="gone"
        />
    <TextView
        android:id="@+id/tv_no_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No record found."
        android:gravity="center"
        android:textColor="@color/colorDarkGray"
        android:layout_centerInParent="true"
        android:visibility="gone"
        />
</RelativeLayout>
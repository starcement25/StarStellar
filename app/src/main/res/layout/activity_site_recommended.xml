<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/llTopView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorHeaderView">

        <include
            android:id="@+id/headeView"
            layout="@layout/common_header" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/llTopView"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_mysite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#414141"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_pending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#414141"
                android:ellipsize="end"
                android:gravity="center"
                android:onClick="pendingList"
                android:paddingTop="@dimen/left_right_margin_15dp"
                android:paddingBottom="@dimen/left_right_margin_15dp"
                android:singleLine="true"
                android:text="Pending"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_approved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#414141"
                android:ellipsize="end"
                android:gravity="center"
                android:onClick="approvedList"
                android:paddingTop="@dimen/left_right_margin_15dp"
                android:paddingBottom="@dimen/left_right_margin_15dp"
                android:singleLine="true"
                android:text="Approved"
                android:textAllCaps="true"
                android:textColor="#878787"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_rejected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#414141"
                android:ellipsize="end"
                android:gravity="center"
                android:onClick="rejectedList"
                android:paddingTop="@dimen/left_right_margin_15dp"
                android:paddingBottom="@dimen/left_right_margin_15dp"
                android:singleLine="true"
                android:text="Rejected"
                android:textAllCaps="true"
                android:textColor="#878787"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_Pending"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ll_tab"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"
        android:divider="@color/colorWhite"
        android:dividerHeight="2dp"
        android:scrollbars="vertical" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_Approved"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ll_tab"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"
        android:divider="@color/colorWhite"
        android:dividerHeight="2dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_Rejected"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ll_tab"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"
        android:divider="@color/colorWhite"
        android:dividerHeight="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_no_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="No record found."
        android:textColor="@color/colorBlack"
        android:visibility="gone" />
</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/llTopView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorHeaderView">

        <include
            android:id="@+id/headeView"
            layout="@layout/common_header" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llTopView"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/left_right_margin_15dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/et_Select_Existing"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_or"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Site_Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Site Name *"
                        android:maxLength="99"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textColorHint="@color/colorDarkGray"
                        android:textColor="@color/colorBlack"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Site_Address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Site Address *"
                        android:maxLength="99"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textColorHint="@color/colorDarkGray"
                        android:textColor="@color/colorBlack"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">
                    <!--                    replaced Potential(MT)-->
                    <EditText
                        android:id="@+id/et_Site_Potential"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Site MT *"
                        android:inputType="numberDecimal"
                        android:maxLength="9"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textColor="@color/colorBlack"
                        android:textColorHint="@color/colorDarkGray"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Contact_person"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contact person Name *"
                        android:maxLength="99"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textColor="@color/colorBlack"
                        android:textColorHint="@color/colorDarkGray"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Cont_Per_Cat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:drawableRight="@drawable/drop"
                        android:editable="false"
                        android:focusable="false"
                        android:hint="Contact person category *"
                        android:maxLength="99"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textColor="@color/colorBlack"
                        android:textColorHint="@color/colorDarkGray"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Mobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Mobile Number *"
                        android:inputType="number"
                        android:maxLength="10"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textColor="@color/colorBlack"
                        android:textColorHint="@color/colorDarkGray"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Expected_Product"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:drawableRight="@drawable/drop"
                        android:editable="false"
                        android:focusable="false"
                        android:hint="Expected Product to be Used *"
                        android:maxLength="99"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textColor="@color/colorBlack"
                        android:textColorHint="@color/colorDarkGray"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Consumption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Expected Consumption (No. of bags) *"
                        android:inputType="number"
                        android:maxLength="19"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textColor="@color/colorBlack"
                        android:textColorHint="@color/colorDarkGray"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/left_right_margin_15dp"
                    android:padding="@dimen/left_right_margin_15dp"
                    android:text="Site Photo"
                    android:textSize="12sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/iv_Star_Logo_B"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_centerInParent="true"
                        android:onClick="chooseYourImage"
                        android:src="@drawable/profile_bg" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/iv_new_site"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/cam" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="25dp"
                    android:background="@drawable/border_red"
                    android:clickable="true"
                    android:gravity="center"
                    android:onClick="add_new_site"
                    android:padding="@dimen/left_right_margin_15dp"
                    android:text="SUBMIT"
                    android:textColor="@color/green" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</RelativeLayout>

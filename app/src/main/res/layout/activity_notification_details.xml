<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F0F1">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/llTopView"
        android:background="@color/colorHeaderView"
        >
        <include
            android:id="@+id/headeView"
            layout="@layout/common_header"
            />
    </LinearLayout>
    <ScrollView
        android:layout_below="@id/llTopView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <ImageView
                android:id="@+id/imNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/default_"
                />
            <TextView
                android:id="@+id/tvNotiTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="9dp"
                android:textColor="@color/colorDarkGray_gb"
                android:textSize="12sp"
                android:text="Notification Title"
                android:textStyle="bold"
                android:gravity="center"
                />
            <TextView
                android:id="@+id/tvNotiMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="9dp"
                android:textColor="@color/colorDarkGray_gb"
                android:textSize="12sp"
                android:text="Details"
                android:gravity="center"
                />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>


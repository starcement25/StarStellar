<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/llTopView"
        android:background="@color/colorHeaderView"
        >
        <include
            android:id="@+id/headeView"
            layout="@layout/common_header"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_below="@id/llTopView"
        android:id="@+id/ll_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        >
        <LinearLayout
            android:id="@+id/ll_mysite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            >
            <TextView
                android:id="@+id/tv_approved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="APPROVED"
                android:textColor="@color/white"
                android:gravity="center"
                android:paddingTop="@dimen/left_right_margin_15dp"
                android:paddingBottom="@dimen/left_right_margin_15dp"
                android:onClick="approvedList"
                android:layout_margin=".5dp"
                android:background="#414141"
                android:textSize="10sp"
                />
            <TextView
                android:id="@+id/tv_pending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PENDING"
                android:textColor="#878787"
                android:gravity="center"
                android:paddingTop="@dimen/left_right_margin_15dp"
                android:paddingBottom="@dimen/left_right_margin_15dp"
                android:onClick="pendingList"
                android:layout_margin=".5dp"
                android:background="#414141"
                android:textSize="10sp"
                />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_below="@+id/ll_tab"
        android:id="@+id/ll_m_search"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"

        android:background="@drawable/border_gray_solid"
        android:layout_margin="10dp"
        >
        <EditText
            android:id="@+id/et_m_search_bar"
            android:layout_width="0dp"
            android:layout_weight="6"
            android:layout_height="match_parent"
            android:paddingStart="5dp"
            android:textSize="12sp"
            android:textColor="@color/colorBlack"
            android:maxLines="1"
            android:inputType="textPersonName"
            android:maxLength="99"
            android:hint="Search "
            android:imeOptions="actionSearch"
            android:layout_gravity="center"
            android:background="@null"

            />
        <ImageView
            android:id="@+id/iv_m_search_clear"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/t_cross"
            android:layout_gravity="center"
            />
    </LinearLayout>
    <ListView
        android:id="@+id/lv_Pending"
        android:layout_below="@id/ll_m_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dividerHeight="2dp"
        android:divider="@color/colorWhite"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"
        android:visibility="gone"
        />
    <ListView
        android:id="@+id/lv_Approved"
        android:layout_below="@id/ll_m_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dividerHeight="2dp"
        android:divider="@color/colorWhite"
        android:layout_marginLeft="@dimen/left_right_margin_3dp"
        android:layout_marginRight="@dimen/left_right_margin_3dp"
        android:visibility="visible"
        />
    <TextView
        android:id="@+id/tv_no_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No record found."
        android:gravity="center"
        android:textColor="@color/colorDarkGray"
        android:layout_centerInParent="true"
        android:visibility="gone"
        />
</RelativeLayout>
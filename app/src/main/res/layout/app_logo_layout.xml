<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true"
    android:background="@drawable/star_logo_rect"
    android:id="@+id/rl_Star_Logo"
    >

    <ImageView
        android:id="@+id/iv_Star_Golden_Logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:layout_below="@+id/iv_Star_Golden_Logo"
        android:id="@+id/iv_Star_Logo"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:src="@drawable/star_logo"
        />
</RelativeLayout>
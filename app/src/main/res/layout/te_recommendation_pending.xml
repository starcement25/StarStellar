<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorWhite"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/llTopView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorHeaderView">

        <include
            android:id="@+id/headeView"
            layout="@layout/common_header" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/sv_recomm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_recomm_bottom"
        android:layout_below="@+id/llTopView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:background="#f2f0f1">

                <ImageView
                    android:id="@+id/iv_mySite_"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/left_right_margin_15dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    android:src="@drawable/default_" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorDarkGray_gb"
                android:padding="15dp"
                android:text="DETAILS OF RECOMMENDATION"
                android:textColor="@color/colorWhite"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/lv_recom_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"  />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_Top_Bottom"
                android:background="@color/colorDarkGray_gb"
                android:padding="15dp"
                android:text="DETAILS OF PRODUCT"
                android:textColor="@color/colorWhite"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:paddingLeft="@dimen/left_right_margin_15dp"
                android:paddingRight="@dimen/padding_Top_Bottom">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Select_product"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:drawableRight="@drawable/drop"
                        android:editable="false"
                        android:focusable="false"
                        android:hint="Select product *"
                        android:textColorHint="@color/colorDarkGray"
                        android:textColor="@color/colorBlack"
                        android:maxLength="99"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Consumption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Actual Consumption (No. of bags)"
                        android:textColorHint="@color/colorDarkGray"
                        android:textColor="@color/colorBlack"
                        android:inputType="number"
                        android:maxLength="19"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginLeft="@dimen/padding_Top_Bottom"
                    android:layout_marginTop="@dimen/padding_Top_Bottom"
                    android:text="From where the bags have been purchased"
                    android:textColor="@color/colorDarkGray_gb"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_dealer_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@id/rb_0"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dealer"
                        android:textColor="@color/colorBlack"/>

                    <RadioButton
                        android:id="@+id/rb_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subdealer"
                        android:textColor="@color/colorBlack"/>

                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Name *"
                        android:textColorHint="@color/colorDarkGray"
                        android:textColor="@color/colorBlack"
                        android:maxLength="99"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Area *"
                        android:textColorHint="@color/colorDarkGray"
                        android:textColor="@color/colorBlack"
                        android:maxLength="99"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/WhiteInputLayout"
                    android:textColorHint="@color/colorDarkGray">

                    <EditText
                        android:id="@+id/et_Contact_Number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contact Number *"
                        android:textColorHint="@color/colorDarkGray"
                        android:textColor="@color/colorBlack"
                        android:inputType="number"
                        android:maxLength="10"
                        android:padding="@dimen/left_right_margin_15dp"
                        android:singleLine="true"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/left_right_margin_15dp"
                android:background="@color/colorDarkGray_gb"
                android:padding="15dp"
                android:text="ENGINEER DETAILS"
                android:textColor="@color/colorWhite"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/lv_te_eng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:paddingLeft="@dimen/left_right_margin_15dp"
                android:paddingRight="@dimen/padding_Top_Bottom"
                android:paddingBottom="@dimen/padding_Top_Bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:text="Comments : "
                    android:textColor="@color/colorDarkGray_gb"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_site_comments"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:background="@drawable/border_gray_solid"
                    android:gravity="top"
                    android:hint="Write comments"
                    android:textColorHint="@color/colorDarkGray"
                    android:inputType="textMultiLine"
                    android:maxLines="9"
                    android:padding="@dimen/left_right_margin_3dp"
                    android:textColor="@color/colorDarkGray_gb"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_right_margin_15dp"
                android:visibility="invisible" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ll_recomm_bottom"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/left_right_margin_15dp"
        android:layout_marginRight="@dimen/left_right_margin_15dp"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/left_right_margin_3dp">

        <TextView
            android:id="@+id/tv_recomm_confirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/padding_Top_Bottom"

            android:layout_weight="1"
            android:background="@drawable/border_red_solid"
            android:clickable="true"
            android:gravity="center"
            android:onClick="recomm_confirm"
            android:text="CONFIRM"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_recomm_reject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/padding_Top_Bottom"
            android:layout_weight="1"
            android:background="@drawable/border_red_solid"
            android:clickable="true"
            android:gravity="center"
            android:onClick="continueReject"
            android:text="REJECT"
            android:textColor="@color/white" />
    </LinearLayout>
</RelativeLayout>
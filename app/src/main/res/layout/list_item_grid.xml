<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    >
    <!--F1F5F7-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/left_right_margin_15dp"
        android:layout_marginRight="@dimen/left_right_margin_15dp"
        android:background="@color/green"
        >
        <ImageView
            android:id="@+id/menu_child_img"
            android:layout_width="60dp"
            android:layout_height="67dp"
            android:src="@drawable/star_logo"
            android:layout_gravity="center"
            android:paddingTop="@dimen/left_right_margin_3dp"
            />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_featureName_T"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:gravity="center"
        android:textColor="@color/colorDarkGray_gb"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textStyle="bold"
        android:paddingTop="@dimen/left_right_margin_3dp"
        />
    <TextView
        android:id="@+id/tv_featureName_B"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:gravity="center"
        android:textColor="@color/colorDarkGray_gb"
        android:textSize="12sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingBottom="@dimen/left_right_margin_3dp"
        />
</LinearLayout>

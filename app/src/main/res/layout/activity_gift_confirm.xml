<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/llTopView"
        android:background="@color/colorHeaderView"
        >
        <include
            android:id="@+id/headeView"
            layout="@layout/common_header"
            />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/padding_Top_Bottom"
        android:layout_marginRight="@dimen/padding_Top_Bottom"
        android:layout_below="@+id/llTopView"
        android:layout_above="@+id/tv_gift_confirm"
        android:id="@+id/sv_gift_0"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <LinearLayout
                android:id="@+id/ll_gift_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/transparent"
                >
                <!--<android.support.v7.widget.CardView-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:elevation="7dp"-->
                <!--card_view:cardCornerRadius="7dp"-->
                <!--xmlns:card_view="http://schemas.android.com/tools"-->
                <!--android:background="@android:color/white"-->
                <!--android:layout_margin="2dp"-->
                <!--&gt;-->
                <!---->
                <!--</android.support.v7.widget.CardView>-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/padding_Top_Bottom"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        >
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="1dp"
                            android:elevation="7dp"
                            card_view:cardCornerRadius="7dp"
                            xmlns:card_view="http://schemas.android.com/tools"
                            >
                            <ImageView
                                android:id="@+id/iv_gift_item"
                                android:layout_width="match_parent"
                                android:layout_height="125dp"
                                android:src="@drawable/default_"
                                />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:layout_gravity="top"
                        android:layout_marginTop="@dimen/left_right_margin_15dp"
                        >
                        <TextView
                            android:id="@+id/tv_git_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/colorDarkGray_gb"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:padding="@dimen/left_right_margin_3dp"
                            />
                        <TextView
                            android:id="@+id/tv_gift_points"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Points- 0"
                            android:textSize="12sp"
                            android:textColor="@color/colorDarkGray"
                            android:maxLines="2"
                            android:ellipsize="end"
                            />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:layout_margin="@dimen/padding_Top_Bottom"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transaction Details"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/colorDarkGray_gb"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:padding="@dimen/left_right_margin_3dp"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/left_right_margin_3dp"

                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Stellar Points"
                        android:textColor="@color/colorDarkGray"
                        android:textSize="12sp"
                        />
                    <TextView
                        android:id="@+id/tv_gift_my_points"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:gravity="right"
                        android:textSize="12sp"
                        android:textColor="@color/colorDarkGray"
                        android:maxLines="2"
                        android:ellipsize="end"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/left_right_margin_3dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="About to be Redeemed"
                        android:textColor="@color/colorDarkGray"
                        android:textSize="12sp"
                        />
                    <TextView
                        android:id="@+id/tv_gift_require_points"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:gravity="right"
                        android:textSize="12sp"
                        android:textColor="@color/colorDarkGray"
                        android:maxLines="2"
                        android:ellipsize="end"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/left_right_margin_3dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Balance"
                        android:textColor="@color/colorDarkGray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        />
                    <TextView
                        android:id="@+id/tv_gift_bal_points"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:gravity="right"
                        android:textSize="12sp"
                        android:textColor="@color/colorDarkGray_gb"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textStyle="bold"
                        />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm Address"
                android:textSize="12sp"
                android:textColor="@color/colorDarkGray_gb"
                android:textStyle="bold"
                android:layout_marginLeft="@dimen/padding_Top_Bottom"
                android:layout_marginTop="@dimen/padding_Top_Bottom"
                />
            <LinearLayout
                android:id="@+id/ll_gift_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/padding_Top_Bottom"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Address *"
                    android:textSize="12sp"
                    android:textColor="@color/colorDarkGray"
                    android:padding="@dimen/left_right_margin_3dp"
                    />
                <EditText
                    android:id="@+id/et_gift_address"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:background="@drawable/border_grey"
                    android:padding="@dimen/padding_Top_Bottom"
                    android:hint="Type address"
                    android:gravity="top"
                    android:maxLines="5"
                    android:maxLength="99"
                    android:inputType="textMultiLine"
                    android:text=""
                    android:textSize="12sp"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/left_right_margin_15dp"
                    android:visibility="invisible"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="City *"
                    android:textSize="12sp"
                    android:textColor="@color/colorDarkGray"
                    android:padding="@dimen/left_right_margin_3dp"
                    />
                <EditText
                    android:id="@+id/et_gift_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_grey"
                    android:padding="@dimen/padding_Top_Bottom"
                    android:hint="Type city"
                    android:maxLength="19"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:text=""
                    android:textSize="12sp"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/left_right_margin_15dp"
                    android:visibility="invisible"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pin *"
                    android:textSize="12sp"
                    android:textColor="@color/colorDarkGray"
                    android:padding="@dimen/left_right_margin_3dp"
                    />
                <EditText
                    android:id="@+id/et_gift_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_grey"
                    android:padding="@dimen/padding_Top_Bottom"
                    android:hint="Type pin"
                    android:maxLength="6"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:text=""
                    android:textSize="12sp"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/left_right_margin_15dp"
                    android:visibility="invisible"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="State *"
                    android:textSize="12sp"
                    android:textColor="@color/colorDarkGray"
                    android:padding="@dimen/left_right_margin_3dp"
                    />
                <EditText
                    android:id="@+id/et_gift_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_grey"
                    android:padding="@dimen/padding_Top_Bottom"
                    android:hint="Type state"
                    android:maxLength="19"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:text=""
                    android:textSize="12sp"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/padding_Top_Bottom"
                    android:visibility="invisible"
                    />
                <CheckBox
                    android:id="@+id/cb_gift_default"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set as default address"
                    android:textColor="@color/colorDarkGray_gb"
                    android:checked="true"
                    />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <CheckBox
                        android:id="@+id/cb_gift_TC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:checked="true"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I agree to T&amp;C"
                        android:textColor="@color/colorDarkGray_gb"
                        android:clickable="true"
                        android:onClick="TC_dialog"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tv_gift_confirm"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/left_right_margin_15dp"
        android:layout_margin="14dp"
        android:background="@drawable/border_red_solid"
        android:textColor="@color/white"
        android:gravity="center"
        android:text="CONFIRM"
        android:layout_alignParentBottom="true"
        android:clickable="true"
        android:onClick="gift_confirm"
        />
</RelativeLayout>